esults.\");\n} else {\n    console.error(\"FAIL: different seeds produced same result (unlikely but possible, or bug).\");\n}\n\nconsole.log(\"Market logic verification complete.\");\n","usedDeprecatedRules":[]},{"filePath":"/app/vite.config.js","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/app/vitest.config.js","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]}]
